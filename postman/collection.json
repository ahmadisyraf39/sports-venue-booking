                  "pm.test(\"Exactly one CONFIRMED payment\", () => {",
                  "    pm.expect(payments).to.have.length(1);",
                  "    pm.expect(payments[0].status).to.eql(\"CONFIRMED\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
