    {
      "name": "3. Booking (saga)",
      "description": "Create Booking starts the saga: booking-service -> RabbitMQ -> payment-service -> booking-service (CONFIRMED) + notification-service.",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"courtId\": {{courtId}},\n    \"venueId\": {{venueId}},\n    \"userId\": {{userId}},\n    \"bookingDate\": \"{{bookingDate}}\",\n    \"startTime\": \"16:00:00\",\n    \"durationHours\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Bookings must be today or later (@FutureOrPresent): use a date one week ahead",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 7);",
                  "pm.collectionVariables.set(\"bookingDate\", d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const booking = pm.response.json();",
                  "pm.test(\"New booking starts as PENDING\", () => pm.expect(booking.status).to.eql(\"PENDING\"));",
                  "pm.collectionVariables.set(\"bookingId\", booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Booking by ID (after saga)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings/{{bookingId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            },
            "description": "If this shows PENDING, send it again after a few seconds."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the saga a few seconds to finish before checking the status",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Saga confirmed the booking\", () => pm.expect(pm.response.json().status).to.eql(\"CONFIRMED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Bookings for User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
