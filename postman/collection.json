    {
      "name": "7. Cleanup",
      "description": "Deletes the court and venue created above (bookings stay: there is no delete endpoint for them).",
      "item": [
        {
          "name": "Delete Court",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courts/{{courtId}}?ownerId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "courts", "{{courtId}}"],
              "query": [
                {
                  "key": "ownerId",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Venue",
          "request": {
            "method": "DELETE",
