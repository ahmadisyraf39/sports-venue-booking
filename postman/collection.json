    {
      "name": "5. Notification",
      "description": "Notifications are created by events, not by an endpoint. Emails go to local Mailpit: http://localhost:8025",
      "item": [
        {
          "name": "Get Notifications for User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/notifications?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const note = pm.response.json().find(n => n.bookingId === pm.collectionVariables.get(\"bookingId\"));",
                  "pm.test(\"Notification sent for this booking\", () => {",
                  "    pm.expect(note, \"notification for this booking\").to.exist;",
                  "    pm.expect(note.type).to.eql(\"BOOKING_CONFIRMED\");",
                  "    pm.expect(note.status).to.eql(\"SENT\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
