{
  "info": {
    "name": "Sports Venue Booking Platform",
    "description": "All requests go through the API Gateway ({{base_url}}), like a real client.\n\nRun the folders in order (or the whole collection with the Collection Runner): 1. Auth registers a fresh user and stores the JWT; every other request sends it automatically via collection-level Bearer auth. IDs (userId, venueId, courtId, bookingId) are saved as collection variables, so the folders chain together.\n\nEmails from the saga go to local Mailpit: http://localhost:8025",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Public endpoints (no token). Register creates a fresh user each run; Login stores the JWT used by every other request.",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"name\": \"Postman Tester\",\n    \"phone\": \"0123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A unique email every run, so Register never hits 409 (email already exists)",
                  "pm.collectionVariables.set(\"email\", `postman-${Date.now()}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"Passw0rd!123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test(\"Response contains a JWT\", () => pm.expect(token.split(\".\")).to.have.length(3));",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        }
      ]
    },
