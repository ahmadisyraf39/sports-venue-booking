# Only needed when sending real emails to Mailtrap (see MAIL_HOST below)
MAILTRAP_USERNAME=your-mailtrap-sandbox-username
MAILTRAP_PASSWORD=your-mailtrap-sandbox-password

# Emails go to local Mailpit (http://localhost:8025) by default.
# Uncomment to send to Mailtrap instead:
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525